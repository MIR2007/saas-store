generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String    @default("")
  role              UserRole  @default(CUSTOMER)
  resetTokenHash    String    @default("")
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  stores            Store[]
}

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

model Store {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String     @unique
  description String     @default("")
  logo        String     @default("")
  phone       String     @default("")
  themeColor  String     @default("#b08d57")
  theme       String     @default("atelier")
  currency    String     @default("EGP")
  walletBalance Float    @default(0)
  active      Boolean    @default(true)
  views       Int        @default(0)
  plan        String     @default("trial")
  planStatus  String     @default("active")
  planRenewsAt DateTime?
  subscriptionNote String @default("")
  onboarding     String     @default("{}")
  freeShippingThreshold Float @default(0)
  shippingRates  String     @default("{}")
  themeConfig    String     @default("{}")
  trackingConfig String     @default("{}")
  customDomain       String?  @unique
  customDomainStatus String   @default("none")
  domainToken        String   @default("")
  domainVerification String   @default("")
  createdAt   DateTime   @default(now())
  categories  Category[]
  products    Product[]
  orders      Order[]
  coupons     Coupon[]
  walletTransactions WalletTransaction[]
  subscriptionRequests SubscriptionRequest[]
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  image    String    @default("")
  products Product[]
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  description  String      @default("")
  price        Float
  comparePrice Float?
  images       String      @default("[]")
  options      String      @default("[]")
  stock        Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  orderItems   OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName   String
  customerPhone  String
  customerCountry String     @default("مصر")
  customerRegion String      @default("")
  customerAddress String     @default("")
  notes          String      @default("")
  status         String      @default("pending")
  subtotal       Float       @default(0)
  discount       Float       @default(0)
  couponCode     String      @default("")
  shipping       Float       @default(0)
  total          Float
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  walletTransactions WalletTransaction[]
}

model Coupon {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code        String
  type        String    @default("percent")
  value       Float     @default(0)
  minSubtotal Float     @default(0)
  maxUses     Int       @default(0)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([storeId, code])
  @@index([storeId, active])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        String   @default("credit")
  amount      Float
  description String   @default("")
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

model SubscriptionRequest {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan      String
  method    String
  reference String
  phone     String   @default("")
  amount    Float
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  quantity  Int
}