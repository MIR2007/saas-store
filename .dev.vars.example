# Local-only secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy this file to `.dev.vars` (gitignored) and fill in the real values.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Cloudflare for SaaS custom hostnames (optional; enables automatic domain attach).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Optional: transactional email for password resets (Resend).
RESEND_API_KEY=""
EMAIL_FROM="Bee Panal <noreply@beepanal.store>"

# Public site URL used in emails and reset links.
NEXT_PUBLIC_SITE_URL

# Google OAuth (merchant signup/login).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
# Optional: override the callback URL (defaults to NEXT_PUBLIC_SITE_URL or localhost).
GOOGLE_REDIRECT_URI="https://beepanal.store"

# Free custom-domain mode (Netlify edge proxy in /custom-domain-proxy).
# When CUSTOM_DOMAIN_PROXY_TARGET is set, merchants point their domains at the
# proxy instead of Cloudflare for SaaS. Leave empty to use Cloudflare for SaaS.
CUSTOM_DOMAIN_PROXY_TARGET=""          # e.g. bp-domains.netlify.app
CUSTOM_DOMAIN_PROXY_SECRET=""          # long random string, same as BP_PROXY_SECRET on Netlify
CUSTOM_DOMAIN_PROXY_APEX_IP=""         # Netlify load balancer IP for apex A records
NETLIFY_API_TOKEN=""                   # Netlify personal access token
NETLIFY_SITE_ID=""                     # ID of the proxy site on Netlify
